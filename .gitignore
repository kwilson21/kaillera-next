# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
# Build output, web/static/dist/ included: the TypeScript bundles are built by
# `npm run build` (locally, in CI and in the Docker image), never committed.
dist/

# EmulatorJS core build artifacts (source repos + compiled output)
build/src/
build/output/

# ROM files — copyrighted, not committed
web/static/rom/
web/static/roms/

# pytest
.pytest_cache/

# Environment
.env

# Node. package-lock.json is committed: the Docker image and the landing
# Worker's build must produce the same bundle bytes (the landing build id).
node_modules/

# OS
.DS_Store

# Playwright MCP logs
.playwright-mcp/

# MCP config (local)
.mcp.json

# Local tooling dirs (Claude, superpowers plugins)
.claude/
.superpowers/

# Git worktrees
.worktrees/

# Runtime logs + local data directories
server/logs/
server/data/
data/
logs/
tests/diag-screenshots/

# Screenshots (dev artifacts)
*.png
!web/static/og/*.png
!web/static/og/cards/*.png
tests/vgp-screenshots/
logs/*.log
logs/*.json
logs/sync/
certs/
build/softfloat/obj/
build/softfloat/libsoftfloat.a

# Hash-golden native test build output
tests/hash-golden/build/
tests/rollback-native/build/
# Root-level ./static symlink that points at web/static — scoped with
# a leading slash so it doesn't also block new files under web/static/.
/static

# Local sandboxes & generated artifacts (added 2026-04-26 for prod cut)
server/kaillera.db
build/build/
build/recomp/
build/recomp-tool/
build/test/
tools/dl-recorder/
web/smash64r-test/
web/webgpu-pivot-test/

# Local gameplay test output (scripts/test-gameplay.sh)
test-results/

# Built static demo (scripts/build_demo.py)
/dist/

# Wrangler local dev state
.wrangler/
dist-landing/

# Apalache working files from `quint verify`
_apalache-out/
