diff --git a/libretro/libretro.c b/libretro/libretro.c
index cabae39..f640319 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -104,6 +104,61 @@ retro_get_cpu_features_t perf_get_cpu_features_cb = NULL;
 
 retro_log_printf_t log_cb = NULL;
 retro_video_refresh_t video_cb = NULL;
+
+/* kaillera-next: Headless tick mode — skip presentation (buffer swap +
+ * video_cb) in retro_run() during rollback replay. GLSM bind/unbind and
+ * GLideN64 rendering still run (#43). CPU emulation (co_switch) always
+ * runs normally. */
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+int kn_headless = 0;
+EMSCRIPTEN_KEEPALIVE void kn_set_headless(int enable) { kn_headless = enable; }
+int kn_skip_rdp_replay = 0;
+EMSCRIPTEN_KEEPALIVE void kn_set_skip_rdp_replay(int enable) { kn_skip_rdp_replay = enable; }
+EMSCRIPTEN_KEEPALIVE int kn_get_skip_rdp_replay(void) { return kn_skip_rdp_replay; }
+
+/* kaillera-next: Write full controller input for a slot.
+ * Called by kn_rollback.c during replay to set inputs before retro_run().
+ * Mirrors the JS applyInputToWasm() logic in shared.js. */
+extern void simulate_input(int user, int key, int down);
+static void kn_apply_controller_present(int slot);
+
+/* Scale N64 analog (+-83) to RetroArch range (+-32767).
+ * MUST match JS applyInputToWasm: Math.trunc(v * (32767.0 / 83.0))
+ * Uses float division + truncation, NOT integer division. */
+static int kn_clamp_analog(int v) {
+    double scaled = (double)v * (32767.0 / 83.0);
+    int result = (int)scaled; /* truncates toward zero like Math.trunc */
+    if (result > 32767) result = 32767;
+    if (result < -32767) result = -32767;
+    return result;
+}
+
+void kn_write_controller(int slot, int buttons, int lx, int ly, int cx, int cy) {
+    int i;
+    if (slot < 0 || slot >= 4)
+        return;
+    kn_apply_controller_present(slot);
+    /* Digital buttons (0-15): each bit maps to a simulate_input key */
+    for (i = 0; i < 16; i++) {
+        simulate_input(slot, i, (buttons >> i) & 1);
+    }
+    /* L-stick: scale N64 range (+-83) to RetroArch range (+-32767) */
+    simulate_input(slot, 16, lx > 0 ? kn_clamp_analog(lx) : 0);   /* X+ right */
+    simulate_input(slot, 17, lx < 0 ? kn_clamp_analog(-lx) : 0);  /* X- left */
+    simulate_input(slot, 18, ly > 0 ? kn_clamp_analog(ly) : 0);    /* Y+ down */
+    simulate_input(slot, 19, ly < 0 ? kn_clamp_analog(-ly) : 0);   /* Y- up */
+    /* C-stick: axis values OR digital button bitmask (bits 20-23) */
+    {
+        int cmax = kn_clamp_analog(83); /* 32767 — matches JS clamp(N64_MAX) */
+        simulate_input(slot, 20, cx > 0 ? kn_clamp_analog(cx) : ((buttons >> 20) & 1) ? cmax : 0);
+        simulate_input(slot, 21, cx < 0 ? kn_clamp_analog(-cx) : ((buttons >> 21) & 1) ? cmax : 0);
+        simulate_input(slot, 22, cy > 0 ? kn_clamp_analog(cy) : ((buttons >> 22) & 1) ? cmax : 0);
+        simulate_input(slot, 23, cy < 0 ? kn_clamp_analog(-cy) : ((buttons >> 23) & 1) ? cmax : 0);
+    }
+}
+#endif
+
 retro_input_poll_t poll_cb = NULL;
 retro_input_state_t input_cb = NULL;
 retro_audio_sample_batch_t audio_batch_cb = NULL;
@@ -2067,7 +2122,17 @@ void retro_run (void)
     {
        glsm_ctl(GLSM_CTL_STATE_UNBIND, NULL);
     }
-    
+
+    /* kaillera-next: headless replay frames still run the GLSM bind/unbind
+     * bracket (and threaded-renderer bookkeeping) above, because GLideN64
+     * issues real GL calls during replay regardless of kn_headless. Skipping
+     * the bracket let those calls run against real GL state that glsm's
+     * shadow cache no longer matched, corrupting frames around rollback
+     * catch-up. Only presentation (buffer swap + video_cb, which would flash
+     * a replay frame to the canvas) is skipped while headless. */
+#ifdef __EMSCRIPTEN__
+    if (!kn_headless) {
+#endif
     if (libretro_swap_buffer)
     {
        if(current_rdp_type == RDP_PLUGIN_GLIDEN64)
@@ -2095,6 +2160,9 @@ void retro_run (void)
         // screen_pitch will be 0 for GLN
         video_cb(NULL, retro_screen_width, retro_screen_height, screen_pitch);
     }
+#ifdef __EMSCRIPTEN__
+    }
+#endif
 }
 
 void retro_reset (void)
