@@ -55,12 +55,14 @@ void write_is_viewer(void* opaque, uint32_t address, uint32_t value, uint32_t ma
     {
         if (word > 0)
         {
-            /* make sure we don't overflow the buffer */
-            if (is_viewer->buffer_pos + word > IS_BUFFER_SIZE)
+            /* Check each operand before adding: CVE-2025-9688. */
+            if (is_viewer->buffer_pos > IS_BUFFER_SIZE
+                || word > IS_BUFFER_SIZE
