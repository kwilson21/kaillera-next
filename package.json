{
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "build:check": "node scripts/build-web.mjs && git diff --exit-code -- web/static/dist/kn-core.js web/static/dist/kn-wake-art.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:ts": "node --test \"tests/ts/*.test.ts\"",
    "fmt": "oxfmt \"**/*.{js,mjs,mts,ts,css,json,jsonc,yaml,yml,html}\"",
    "fmt:check": "oxfmt --check \"**/*.{js,mjs,mts,ts,css,json,jsonc,yaml,yml,html}\"",
    "lint": "oxlint web/static web/src deploy/static tests && biome lint",
    "spec": "bash scripts/check-specs.sh",
    "spec:verify": "bash scripts/verify-specs.sh",
    "protocol": "uv run --directory server --frozen --extra dev python ../scripts/gen_protocol.py",
    "protocol:check": "uv run --directory server --frozen --extra dev python ../scripts/gen_protocol.py --check",
    "diagram": "node scripts/session-diagram.mjs && node scripts/peer-connection-diagram.mjs",
    "diagram:check": "node scripts/session-diagram.mjs --check && node scripts/peer-connection-diagram.mjs --check",
    "traces": "node scripts/trace-diagram.mjs",
    "traces:check": "node scripts/trace-diagram.mjs --check",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run test:ts && npm run protocol:check && npm run build:check && npm run diagram:check && npm run traces:check && npm run spec"
  },
  "dependencies": {
    "@xstate/effect": "1.0.0-beta.1",
    "effect": "4.1.4",
    "xstate": "6.0.0-beta.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@informalsystems/quint": "0.33.1",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "lemmascript": "0.6.8",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "^1.64.1",
    "typescript": "7.0.2",
    "wrangler": "^4.151.2"
  }
}
