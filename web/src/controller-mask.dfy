function lateChange(from: int, frontier: int, maskBefore: int, mask: int): bool
{
  ((from < frontier) && (maskBefore != mask))
}

lemma lateChange_ensures(from: int, frontier: int, maskBefore: int, mask: int)
  ensures (lateChange(from, frontier, maskBefore, mask) <==> ((from < frontier) && (maskBefore != mask)))
{
}

const MASK_LEAD: int := 60

method changeInEffect(froms: seq<int>, frame: int) returns (res: int)
  ensures (-1 <= res)
  ensures (res < |froms|)
  ensures ((res >= 0) ==> (froms[res] <= frame))
  ensures forall k: nat :: ((res < k) ==> (k < |froms|) ==> (froms[k] > frame))
{
  var i := |froms|;
  while (i > 0)
    invariant (0 <= i)
    invariant (i <= |froms|)
    invariant forall k: nat :: ((i <= k) ==> (k < |froms|) ==> (froms[k] > frame))
    decreases i
  {
    if (froms[(i - 1)] <= frame) {
      return (i - 1);
    }
    i := (i - 1);
  }
  return -1;
}

method fileIndex(froms: seq<int>, from: int) returns (res: int)
  ensures (0 <= res)
  ensures (res <= |froms|)
  ensures forall k: nat :: ((k < res) ==> (froms[k] < from))
  ensures ((res < |froms|) ==> (froms[res] >= from))
{
  var i := 0;
  while (i < |froms|)
    invariant (0 <= i)
    invariant (i <= |froms|)
    invariant forall k: nat :: ((k < i) ==> (froms[k] < from))
    decreases (|froms| - i)
  {
    if (froms[i] >= from) {
      return i;
    }
    i := (i + 1);
  }
  return |froms|;
}
