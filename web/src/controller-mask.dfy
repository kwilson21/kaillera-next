function lateChange(from: int, frontier: int, maskBefore: int, mask: int): bool
{
  ((from < frontier) && (maskBefore != mask))
}

lemma lateChange_ensures(from: int, frontier: int, maskBefore: int, mask: int)
  ensures (lateChange(from, frontier, maskBefore, mask) <==> ((from < frontier) && (maskBefore != mask)))
{
}

function rosterScheduled(scheduling: bool, announcedFrame: int, rosterFrame: int): bool
{
