// Generated by lsc from game-phase.ts

datatype MatchState = elsewhere | starting | playing | paused | other

function matchState(scene: int, status: int, battleScene: int): MatchState
{
  if ((battleScene < 0) || (scene != battleScene)) then
    MatchState.elsewhere
  else
    if (status == 0) then
      MatchState.starting
    else
      if (status == 1) then
        MatchState.playing
      else
        if (status == 2) then
          MatchState.paused
        else
          MatchState.other
}

lemma matchState_ensures(scene: int, status: int, battleScene: int)
  ensures (((battleScene < 0) || (scene != battleScene)) ==> matchState(scene, status, battleScene).elsewhere?)
  ensures ((battleScene >= 0) ==> (scene == battleScene) ==> (status == 0) ==> matchState(scene, status, battleScene).starting?)
  ensures ((battleScene >= 0) ==> (scene == battleScene) ==> (status == 1) ==> matchState(scene, status, battleScene).playing?)
  ensures ((battleScene >= 0) ==> (scene == battleScene) ==> (status == 2) ==> matchState(scene, status, battleScene).paused?)
  ensures (matchState(scene, status, battleScene).other? ==> (((((battleScene >= 0) && (scene == battleScene)) && (status != 0)) && (status != 1)) && (status != 2)))
{
}

function isSteeredMenu(scene: int, title: int, menuFirst: int, menuLast: int): bool
{
  if (((title < 0) || (menuFirst < 0)) || (menuLast < 0)) then
    false
  else
    ((scene == title) || ((menuFirst <= scene) && (scene <= menuLast)))
}

lemma isSteeredMenu_ensures(scene: int, title: int, menuFirst: int, menuLast: int)
  ensures ((((title < 0) || (menuFirst < 0)) || (menuLast < 0)) ==> !(isSteeredMenu(scene, title, menuFirst, menuLast)))
  ensures ((title >= 0) ==> (menuFirst >= 0) ==> (menuLast >= 0) ==> (scene == title) ==> isSteeredMenu(scene, title, menuFirst, menuLast))
  ensures ((title >= 0) ==> (menuFirst >= 0) ==> (menuLast >= 0) ==> (menuFirst <= scene) ==> (scene <= menuLast) ==> isSteeredMenu(scene, title, menuFirst, menuLast))
  ensures (isSteeredMenu(scene, title, menuFirst, menuLast) ==> ((scene == title) || ((menuFirst <= scene) && (scene <= menuLast))))
