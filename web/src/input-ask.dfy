method framesToAskFor(have: seq<bool>, from: int, through: int, peerHas: int, max: int) returns (res: seq<int>)
  requires (from >= 0)
  requires (max >= 0)
  requires ((through - from) < |have|)
  ensures (|res| <= max)
  ensures forall j: nat :: ((j < |res|) ==> ((((from <= res[j]) && (res[j] <= through)) && (res[j] <= peerHas)) && !(have[(res[j] - from)])))
  ensures forall j: nat :: (((j + 1) < |res|) ==> (res[j] < res[(j + 1)]))
{
  var asked: seq<int> := [];
  var last := (if (through < peerHas) then through else peerHas);
  var f := from;
  while ((f <= last) && (|asked| < max))
    invariant (from <= f)
    invariant (|asked| <= max)
    invariant forall j: nat :: ((j < |asked|) ==> ((((from <= asked[j]) && (asked[j] < f)) && (asked[j] <= last)) && !(have[(asked[j] - from)])))
    invariant forall j: nat :: (((j + 1) < |asked|) ==> (asked[j] < asked[(j + 1)]))
    decreases ((last + 1) - f)
  {
    if !(have[(f - from)]) {
      asked := (asked + [f]);
    }
    f := (f + 1);
  }
  return asked;
}
