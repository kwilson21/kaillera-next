method framesToSendAgain(ack: int, newest: int, max: int) returns (res: seq<int>)
  requires (max >= 0)
  ensures (|res| <= max)
  ensures forall j: nat :: ((j < |res|) ==> (((0 <= res[j]) && (ack < res[j])) && (res[j] <= newest)))
  ensures forall j: nat :: (((j + 1) < |res|) ==> (res[(j + 1)] == (res[j] + 1)))
  ensures ((|res| > 0) ==> (res[(|res| - 1)] == newest))
  ensures ((ack >= -1) ==> ((newest - ack) <= max) ==> (newest > ack) ==> (|res| == (newest - ack)))
{
  var frames: seq<int> := [];
  var first := (ack + 1);
  if (first < ((newest - max) + 1)) {
    first := ((newest - max) + 1);
  }
  if (first < 0) {
    first := 0;
  }
  var f := first;
  while (f <= newest)
    invariant (first <= f)
    invariant ((f <= (newest + 1)) || (f == first))
    invariant (|frames| == (f - first))
    invariant forall j: nat :: ((j < |frames|) ==> (frames[j] == (first + j)))
    decreases ((newest + 1) - f)
  {
    frames := (frames + [f]);
    f := (f + 1);
  }
  return frames;
}
