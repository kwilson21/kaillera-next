datatype Option<T> = None | Some(value: T)

function SeqFind<T>(s: seq<T>, p: T -> bool): Option<T>
  ensures SeqFind(s, p).Some? ==> p(SeqFind(s, p).value)
  ensures SeqFind(s, p).Some? ==> SeqFind(s, p).value in s
  ensures SeqFind(s, p).Some? ==>
    exists i: nat :: i < |s| && s[i] == SeqFind(s, p).value && p(s[i]) &&
                     (forall j: nat :: j < i ==> !p(s[j]))
  ensures SeqFind(s, p).None? ==> forall i :: 0 <= i < |s| ==> !p(s[i])
  decreases |s|
{
  if |s| == 0 then None
  else if p(s[0]) then Some(s[0])
  else SeqFind(s[1..], p)
}

datatype Connection = Connection(key: string, slot: int, persistentId: string, live: bool)

datatype KnownPlayer = KnownPlayer(key: string, persistentId: string, socketId: string)

datatype RosterPlayer = RosterPlayer(persistentId: string, socketId: string, slot: int)

method liveConnectionOf(connections: seq<Connection>, persistentId: string, slot: int, sid: string) returns (res: int)
  requires (|persistentId| > 0)
  ensures (-1 <= res)
  ensures (res < |connections|)
  ensures ((res >= 0) ==> ((((connections[res].persistentId == persistentId) && (connections[res].slot == slot)) && connections[res].live) && (connections[res].key != sid)))
  ensures ((res == -1) ==> forall k: nat :: ((k < |connections|) ==> !(((((connections[k].persistentId == persistentId) && (connections[k].slot == slot)) && connections[k].live) && (connections[k].key != sid)))))
{
  var i := 0;
  while (i < |connections|)
    invariant (0 <= i)
    invariant (i <= |connections|)
    invariant forall k: nat :: ((k < i) ==> !(((((connections[k].persistentId == persistentId) && (connections[k].slot == slot)) && connections[k].live) && (connections[k].key != sid))))
    decreases (|connections| - i)
  {
    var c := connections[i];
    if ((((c.persistentId == persistentId) && (c.slot == slot)) && c.live) && (c.key != sid)) {
      return i;
    }
    i := (i + 1);
  }
  return -1;
}

method rosterKey(player: RosterPlayer, isOwn: bool, connections: seq<Connection>, previouslyKnown: seq<KnownPlayer>) returns (res: string)
  ensures (isOwn ==> (res == player.socketId))
{
  var sid := player.socketId;
  if (isOwn || (exists c :: c in connections && (c.key == sid))) {
    return sid;
  }
  var i_known_idx := 0;
  while i_known_idx < |previouslyKnown|
    invariant (i_known_idx <= |previouslyKnown|)
  {
    var known := previouslyKnown[i_known_idx];
    if !(((known.persistentId != player.persistentId) || (known.key == sid))) {
      var kept := SeqFind(connections, (c: Connection) => ((c.key == known.key) && (c.slot == player.slot)));
      match kept {
        case Some(i_kept_val) =>
          if ((known.socketId == sid) || i_kept_val.live) {
            return known.key;
          }
        case None =>

      }
    }
    i_known_idx := i_known_idx + 1;
  }
  if (|player.persistentId| > 0) {
    var i_t0 := liveConnectionOf(connections, player.persistentId, player.slot, sid);
    var index := i_t0;
    if (index >= 0) {
      return connections[index].key;
    }
  }
  return sid;
}
