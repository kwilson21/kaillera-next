method staleHoldersOf(holders: seq<SlotHolder>, sid: string, slot: int) returns (res: seq<string>)
  requires (slot >= 0)
  ensures forall j: nat :: ((j < |res|) ==> (res[j] != sid))
  ensures (|res| <= |holders|)
{
  var stale: seq<string> := [];
  var i := 0;
  while (i < |holders|)
    invariant (0 <= i)
    invariant (i <= |holders|)
    invariant (|stale| <= i)
    invariant forall j: nat :: ((j < |stale|) ==> (stale[j] != sid))
    decreases (|holders| - i)
  {
    var holder := holders[i];
    if ((holder.key != sid) && (holder.slot == slot)) {
      stale := (stale + [holder.key]);
    }
    i := (i + 1);
  }
  return stale;
}
