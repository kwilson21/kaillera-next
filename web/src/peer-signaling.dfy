datatype SignalDisposition = replaceKept | create | reset | apply | drop

datatype DisconnectDisposition = retryStartup | reconnect | hardDisconnect

datatype SlotHolder = SlotHolder(key: string, slot: int)

function shouldInitiate(lateJoiner: bool, running: bool, held: bool, spectator: bool, mySlot: int, theirSlot: int): bool
{
  (lateJoiner || (if ((running || held) || spectator) then false else (mySlot < theirSlot)))
}

lemma shouldInitiate_ensures(lateJoiner: bool, running: bool, held: bool, spectator: bool, mySlot: int, theirSlot: int)
  ensures (lateJoiner ==> (shouldInitiate(lateJoiner, running, held, spectator, mySlot, theirSlot) == true))
  ensures (!(lateJoiner) ==> ((running || held) || spectator) ==> (shouldInitiate(lateJoiner, running, held, spectator, mySlot, theirSlot) == false))
  ensures (!(lateJoiner) ==> !(running) ==> !(held) ==> !(spectator) ==> (shouldInitiate(lateJoiner, running, held, spectator, mySlot, theirSlot) == (mySlot < theirSlot)))
{
}

function signalDisposition(isOffer: bool, reconnect: bool, underEarlierId: bool, hasEntry: bool): string
{
  if !(isOffer) then
    if hasEntry then
      "apply"
    else
      "drop"
  else
    if (!(reconnect) && underEarlierId) then
      "replaceKept"
    else
      if !(hasEntry) then
        "create"
      else
        if reconnect then
          "reset"
        else
          "apply"
}

lemma signalDisposition_ensures(isOffer: bool, reconnect: bool, underEarlierId: bool, hasEntry: bool)
  ensures (!(isOffer) ==> hasEntry ==> (signalDisposition(isOffer, reconnect, underEarlierId, hasEntry) == "apply"))
  ensures (!(isOffer) ==> !(hasEntry) ==> (signalDisposition(isOffer, reconnect, underEarlierId, hasEntry) == "drop"))
  ensures (isOffer ==> !(reconnect) ==> underEarlierId ==> (signalDisposition(isOffer, reconnect, underEarlierId, hasEntry) == "replaceKept"))
  ensures (isOffer ==> !((!(reconnect) && underEarlierId)) ==> !(hasEntry) ==> (signalDisposition(isOffer, reconnect, underEarlierId, hasEntry) == "create"))
  ensures (isOffer ==> reconnect ==> hasEntry ==> (signalDisposition(isOffer, reconnect, underEarlierId, hasEntry) == "reset"))
  ensures (isOffer ==> !(reconnect) ==> !(underEarlierId) ==> hasEntry ==> (signalDisposition(isOffer, reconnect, underEarlierId, hasEntry) == "apply"))
{
}

function disconnectDisposition(beforeStart: bool, initiator: bool, intentionalLeave: bool, pendingLateJoin: bool, running: bool): string
{
  if intentionalLeave then
    "hardDisconnect"
  else
    if (beforeStart && initiator) then
      "retryStartup"
    else
      if pendingLateJoin then
        "hardDisconnect"
      else
        if running then
          "reconnect"
        else
          "hardDisconnect"
}

lemma disconnectDisposition_ensures(beforeStart: bool, initiator: bool, intentionalLeave: bool, pendingLateJoin: bool, running: bool)
  ensures (intentionalLeave ==> (disconnectDisposition(beforeStart, initiator, intentionalLeave, pendingLateJoin, running) == "hardDisconnect"))
  ensures (beforeStart ==> initiator ==> !(intentionalLeave) ==> (disconnectDisposition(beforeStart, initiator, intentionalLeave, pendingLateJoin, running) == "retryStartup"))
  ensures ((disconnectDisposition(beforeStart, initiator, intentionalLeave, pendingLateJoin, running) == "reconnect") ==> ((running && !(intentionalLeave)) && !(pendingLateJoin)))
  ensures (!((beforeStart && initiator)) ==> !(intentionalLeave) ==> !(pendingLateJoin) ==> running ==> (disconnectDisposition(beforeStart, initiator, intentionalLeave, pendingLateJoin, running) == "reconnect"))
{
}

function hasAttemptLeft(attempt: int, maxAttempts: int): bool
  requires (attempt >= 1)
  requires (maxAttempts >= 1)
{
  (attempt < maxAttempts)
}

