// Generated by lsc from game-start.ts

datatype Option<T> = None | Some(value: T)

datatype GameStartPlan = watch | askForSharedRom | awaitSharedRom | wrongRom | play

function gameStartPlan(needsNoRom: bool, hasRom: bool, romDiffers: bool, hostShares: bool, tookHostsRom: bool, undecided: bool): GameStartPlan
{
  if needsNoRom then
    GameStartPlan.watch
  else
    if (romDiffers && !(tookHostsRom)) then
      if (hostShares && undecided) then
        GameStartPlan.askForSharedRom
      else
        GameStartPlan.wrongRom
    else
      if (hostShares && !(hasRom)) then
        if tookHostsRom then
          GameStartPlan.awaitSharedRom
        else
          GameStartPlan.askForSharedRom
      else
        GameStartPlan.play
}

lemma gameStartPlan_ensures(needsNoRom: bool, hasRom: bool, romDiffers: bool, hostShares: bool, tookHostsRom: bool, undecided: bool)
  ensures (needsNoRom ==> gameStartPlan(needsNoRom, hasRom, romDiffers, hostShares, tookHostsRom, undecided).watch?)
  ensures (!(needsNoRom) ==> hasRom ==> (!(romDiffers) || tookHostsRom) ==> gameStartPlan(needsNoRom, hasRom, romDiffers, hostShares, tookHostsRom, undecided).play?)
  ensures (gameStartPlan(needsNoRom, hasRom, romDiffers, hostShares, tookHostsRom, undecided).play? ==> ((!(needsNoRom) && (!(romDiffers) || tookHostsRom)) && (hasRom || !(hostShares))))
  ensures (gameStartPlan(needsNoRom, hasRom, romDiffers, hostShares, tookHostsRom, undecided).wrongRom? ==> (((!(needsNoRom) && romDiffers) && !(tookHostsRom)) && !((hostShares && undecided))))
  ensures (gameStartPlan(needsNoRom, hasRom, romDiffers, hostShares, tookHostsRom, undecided).awaitSharedRom? ==> (((!(needsNoRom) && hostShares) && tookHostsRom) && !(hasRom)))
  ensures (gameStartPlan(needsNoRom, hasRom, romDiffers, hostShares, tookHostsRom, undecided).askForSharedRom? ==> ((!(needsNoRom) && hostShares) && !(tookHostsRom)))
{
}

function handlesGameEnd(endedMatchId: string, lastHandledMatchId: string, leftByMachine: bool, gameOn: bool): bool
{
  if ((endedMatchId != "") && (endedMatchId == lastHandledMatchId)) then
    false
  else
    (leftByMachine || gameOn)
}

lemma handlesGameEnd_ensures(endedMatchId: string, lastHandledMatchId: string, leftByMachine: bool, gameOn: bool)
  ensures (handlesGameEnd(endedMatchId, lastHandledMatchId, leftByMachine, gameOn) ==> (leftByMachine || gameOn))
  ensures (handlesGameEnd(endedMatchId, lastHandledMatchId, leftByMachine, gameOn) ==> ((endedMatchId == "") || (endedMatchId != lastHandledMatchId)))
  ensures ((leftByMachine || gameOn) ==> ((endedMatchId == "") || (endedMatchId != lastHandledMatchId)) ==> handlesGameEnd(endedMatchId, lastHandledMatchId, leftByMachine, gameOn))
{
}

function gameEndedMessage(reason: Option<string>): string
{
  if (match reason { case Some(i_value) => (i_value == "dropped") case None => false }) then
    "You were disconnected for too long. Rejoining..."
  else
    "The host has ended the game"
}
