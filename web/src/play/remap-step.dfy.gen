// Generated by lsc from remap-step.ts

datatype StepKind = button | axis | cbutton

datatype InputKind = button | axis | key | skip

datatype StepVerdict = advance | done | ignore | wrongStick

function stepVerdict(stepKind: StepKind, input: InputKind, hasPad: bool, pairedAxis: int, inputAxis: int, step: int, stepCount: int): StepVerdict
  requires (0 <= step)
  requires (step < stepCount)
{
  if input.button? then
    if (!(hasPad) || stepKind.axis?) then
      StepVerdict.ignore
    else
      if input.axis? then
        if (!(hasPad) || stepKind.button?) then
          StepVerdict.ignore
        else
          if ((stepKind.axis? && (pairedAxis >= 0)) && (pairedAxis != inputAxis)) then
            StepVerdict.wrongStick
          else
            if (step == (stepCount - 1)) then
              StepVerdict.done
            else
              StepVerdict.advance
      else
        if (step == (stepCount - 1)) then
          StepVerdict.done
        else
          StepVerdict.advance
  else
    if input.axis? then
      if (!(hasPad) || stepKind.button?) then
        StepVerdict.ignore
      else
        if ((stepKind.axis? && (pairedAxis >= 0)) && (pairedAxis != inputAxis)) then
          StepVerdict.wrongStick
        else
          if (step == (stepCount - 1)) then
            StepVerdict.done
          else
            StepVerdict.advance
    else
      if (step == (stepCount - 1)) then
        StepVerdict.done
      else
        StepVerdict.advance
}

lemma stepVerdict_ensures(stepKind: StepKind, input: InputKind, hasPad: bool, pairedAxis: int, inputAxis: int, step: int, stepCount: int)
  requires (0 <= step)
  requires (step < stepCount)
  ensures ((input.key? || input.skip?) ==> (stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).advance? || stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).done?))
  ensures ((input.button? || input.axis?) ==> !(hasPad) ==> stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).ignore?)
  ensures (input.button? ==> stepKind.axis? ==> stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).ignore?)
  ensures (input.axis? ==> stepKind.button? ==> stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).ignore?)
  ensures (stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).wrongStick? ==> ((((hasPad && input.axis?) && stepKind.axis?) && (pairedAxis >= 0)) && (pairedAxis != inputAxis)))
  ensures (hasPad ==> input.axis? ==> stepKind.axis? ==> (pairedAxis >= 0) ==> (pairedAxis != inputAxis) ==> stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).wrongStick?)
  ensures (stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).done? ==> (step == (stepCount - 1)))
  ensures (stepVerdict(stepKind, input, hasPad, pairedAxis, inputAxis, step, stepCount).advance? ==> (step < (stepCount - 1)))
{
}

function stepAfter(step: int, verdict: StepVerdict): int
  requires (0 <= step)
{
  if (verdict.advance? || verdict.done?) then
    (step + 1)
  else
    step
}

lemma stepAfter_ensures(step: int, verdict: StepVerdict)
  requires (0 <= step)
  ensures ((verdict.advance? || verdict.done?) ==> (stepAfter(step, verdict) == (step + 1)))
  ensures ((verdict.ignore? || verdict.wrongStick?) ==> (stepAfter(step, verdict) == step))
{
}
