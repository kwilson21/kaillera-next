    "keep"
  else
    if !(roomPlaying) then
      "gameEnded"
    else
      if (((|pageMatchId| > 0) && (|roomMatchId| > 0)) && (pageMatchId != roomMatchId)) then
        "matchReplaced"
      else
        "keep"
}

