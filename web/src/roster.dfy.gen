// Generated by lsc from roster.ts

datatype RosterEntry = RosterEntry(sid: string, healthy: bool, reconnecting: bool)

method meshHealTargets(roster: seq<RosterEntry>, ownSids: seq<string>) returns (res: seq<string>)
  ensures forall j: nat :: ((j < |res|) ==> !((res[j] in ownSids)))
  ensures (|res| <= |roster|)
{
  var targets: seq<string> := [];
  var i := 0;
  while (i < |roster|)
    invariant (0 <= i)
    invariant (i <= |roster|)
    invariant (|targets| <= i)
    invariant forall j: nat :: ((j < |targets|) ==> !((targets[j] in ownSids)))
    decreases (|roster| - i)
  {
    var entry := roster[i];
    if ((!((entry.sid in ownSids)) && !(entry.healthy)) && !(entry.reconnecting)) {
      targets := (targets + [entry.sid]);
    }
    i := (i + 1);
  }
  return targets;
}
