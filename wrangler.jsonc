// Cloudflare deploy for the static rollback demo.
//   python scripts/build_demo.py && npx wrangler deploy
// Everything under dist/ is served as-is; there is no server-side code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaillera-next",
  "compatibility_date": "2026-09-01",
  // No routes: kaillera-next.thesuperhuman.us belongs to the game server
  // (deploy/vps, via Cloudflare Tunnel), which serves the site, /play and
  // the API. A custom-domain route here would take the whole hostname back.
  // One canonical URL: no <name>.<account>.workers.dev address (or preview URLs).
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
